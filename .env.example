# Copy to .env.local for local development. Add the same values in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
# Lets the Studio's Preview tab show unpublished changes
SANITY_API_READ_TOKEN=
# Online payments (me.sumup.com → Settings → For developers → Toolkit → API keys)
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
NEXT_PUBLIC_SITE_URL=
# Newsletter (Brevo: Honey & Haven's own account). The signup appears once all three are set.
# BREVO_API_KEY: Brevo → SMTP & API → API keys. BREVO_LIST_ID: Contacts → Lists (the number).
# BREVO_DOI_TEMPLATE_ID: the "confirm your subscription" template (Templates → its ID).
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
# Optional: Instagram feed on the home page
INSTAGRAM_ACCESS_TOKEN=
# Any long random text; lets Vercel Cron refresh the Instagram token weekly
CRON_SECRET=
# Optional: Google rating and reviews on the home page
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
