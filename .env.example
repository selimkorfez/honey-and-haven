# Copy to .env.local for local development. Add the same values in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
# Online payments (me.sumup.com → Settings → For developers → Toolkit → API keys)
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
NEXT_PUBLIC_SITE_URL=
# Optional: Instagram feed on the home page
INSTAGRAM_ACCESS_TOKEN=
# Any long random text; lets Vercel Cron refresh the Instagram token weekly
CRON_SECRET=
# Optional: Google rating and reviews on the home page
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
